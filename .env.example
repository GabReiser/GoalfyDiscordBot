# ─── Discord ────────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → sua aplicação
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Servidor da empresa (clique direito no servidor → Copiar ID)
DISCORD_GUILD_ID=
# Canal(is) de fórum do N2/N3, separados por vírgula
DISCORD_FORUM_CHANNEL_IDS=
# Cargo(s) da triagem N2/N3: podem criar/vincular cards, mudar status e mover fases.
# Vazio = qualquer pessoa pode. Quem tem "Gerenciar tópicos" sempre pode.
DISCORD_TRIAGE_ROLE_IDS=
# Canal onde o bot avisa sobre tópicos sem destino (vazio = desliga o lembrete)
DISCORD_TRIAGE_CHANNEL_ID=
# Tag do fórum usada para cada status do tópico. Útil para reaproveitar tags de um fórum
# que já existe. Formato: status=Nome da tag, separados por ";". Status: triage, waiting,
# card, resolved, rejected. Omitido = nome padrão ("Em Triagem", "Aguardando Informação",
# "Card Criado", "Resolvido", "Não Procede"). Vazio = o bot não mexe em tags nesse status.
# Ex.: DISCORD_STATUS_TAGS=triage=Pendente;waiting=;card=;resolved=Resolvido;rejected=
DISCORD_STATUS_TAGS=
# Depois de quantas horas sem destino o tópico entra no lembrete (0 = desliga)
STALE_TOPIC_HOURS=24

# ─── Goalfy ─────────────────────────────────────────────────────────────────
# Gere em https://app.goalfy.com.br/settings/0 → "Gerar Chave"
GOALFY_TOKEN=
# ID do board de backlog (URL: app.goalfy.com.br/boards/<ID>)
GOALFY_BOARD_ID=
# Opcional: formulário usado para criar cards. Vazio = "Formulário Inicial" do board.
GOALFY_MODEL_ID=

# Opcional: fieldInfoId de cada campo do formulário do card.
# Vazio = detecta pelo nome do campo. Rode `npm run discover -- <boardId>` para ver.
# O que não tiver campo correspondente vai como comentário no card.
GOALFY_FIELD_TITLE=
GOALFY_FIELD_DESCRIPTION=
GOALFY_FIELD_EXPECTED_RESULT=
GOALFY_FIELD_FRONT=
GOALFY_FIELD_TYPE=
GOALFY_FIELD_ORIGIN=
GOALFY_FIELD_CLIENT=
GOALFY_FIELD_SEVERITY=
GOALFY_FIELD_DISCORD_LINK=
GOALFY_FIELD_TICKET_LINK=
GOALFY_FIELD_REQUESTER=

# Fases finais (nome ou ID, separados por vírgula). Quando o card chega nelas,
# o tópico vira "✅ Resolvido". Vazio = usa as fases marcadas como "concluída" no board.
GOALFY_DONE_PHASES=

# ─── Sincronização ──────────────────────────────────────────────────────────
# Intervalo para checar mudanças de fase e comentários na Goalfy
SYNC_INTERVAL_SECONDS=120
# Espelha no tópico os comentários feitos no card
SYNC_COMMENTS=true
# Arquiva o tópico quando o card chega na fase final
ARCHIVE_ON_DONE=true

# ─── Webhook (opcional, recomendado) ────────────────────────────────────────
# URL pública (HTTPS) onde a Goalfy consegue chegar no bot. Com ela definida, o bot
# sobe um servidor HTTP e assina o evento de mudança de fase do board: o aviso no
# tópico passa a ser instantâneo. Vazio = só polling.
WEBHOOK_PUBLIC_URL=
# Só para o docker-compose (perfil "webhook"): domínio do certificado HTTPS do Caddy.
# Deve ser o mesmo host de WEBHOOK_PUBLIC_URL, sem https:// (ex.: bot.suaempresa.com.br)
WEBHOOK_DOMAIN=
# Porta local do servidor HTTP (o proxy/ingress aponta para ela)
WEBHOOK_PORT=3000
# Segredo que vai na URL do webhook. Vazio = gerado e guardado no banco.
WEBHOOK_SECRET=

DATABASE_PATH=data/bot.db
# debug | info | warn | error
LOG_LEVEL=info
